<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces a single, self-contained gitlab-cloner.exe that runs on any Windows x64
  machine without the .NET runtime installed:

    dotnet publish src/GitlabCloner.Cli -p:PublishProfile=win-x64

  Output: publish/gitlab-cloner.exe (+ appsettings.json next to it).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
